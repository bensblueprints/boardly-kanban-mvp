# Directory for sync.db and blob storage (blobs/<account_id>/<uuid>)
# DATA_DIR=./data

# HTTP port
# PORT=5400

# Enables POST /dev/accounts (dev-only token minting without billing). Also
# the only token-delivery path in the mail-not-configured degraded mode.
# Unset in production once Whop + SMTP are wired up.
# DEV_BOOTSTRAP_KEY=change-me

# Per-attachment upload cap in megabytes
# MAX_ATTACHMENT_MB=100

# ---- Whop billing ----
# Required for entitlement checks (webhook + daily revalidation):
# App API key from Whop Dashboard -> Developer. Bearer token for membership
# lookups (GET /api/v1/memberships).
# WHOP_API_KEY=
# Product (access pass) id of the "Boardly Cloud Sync" $5/mo product.
# WHOP_PRODUCT_ID=

# Recommended: webhook signing secret from the Whop webhook you create
# (endpoint URL: https://<your-domain>/webhooks/whop, events:
# membership.went_valid / membership.went_invalid a.k.a.
# membership.activated / membership.deactivated). Without it the webhook
# route stays disabled (503) and entitlements are only kept fresh by the
# daily revalidation job.
# WHOP_WEBHOOK_SECRET=

# ---- SMTP mail (token delivery) ----
# Required for token emails (webhook delivery + /portal/request-token).
# Without these the server runs in degraded mode: entitlements are still
# maintained, but tokens can only be minted via the dev bootstrap.
# Google Workspace / Gmail: enable 2FA on the sender account, then create
# an app password at https://myaccount.google.com/apppasswords and use it
# as SMTP_PASS (never the account password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=sync@onetimesuite.com
# SMTP_PASS=
# From address for token emails (default: SMTP_USER).
# MAIL_FROM=Boardly <sync@onetimesuite.com>

# Optional:
# Public base URL of this server (informational; not required).
# PORTAL_BASE_URL=https://sync.example.com
# Hosted Whop checkout link, shown on the portal page when set.
# WHOP_CHECKOUT_URL=
# Grace period after a membership goes invalid, in days (default 3).
# GRACE_DAYS=3
