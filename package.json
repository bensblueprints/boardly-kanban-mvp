{
  "name": "boardly",
  "version": "1.8.0",
  "description": "Self-hosted kanban board. Pay once, own it forever — no Trello per-seat subscription.",
  "author": "Ben (bensblueprints)",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "postinstall": "node scripts/setup-native.js",
    "desktop": "electron .",
    "test": "node test/smoke.js",
    "test:mcp": "node test/mcp.js",
    "test:mcp-http": "node test/mcp-http.js",
    "test:all": "node test/smoke.js && node test/mcp.js && node test/mcp-http.js && node test/coach.js",
    "dist": "npm run build && electron-builder --win nsis",
    "test:coach": "node test/coach.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hello-pangea/dnd": "^17.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.474.0",
    "marked": "^15.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.bensblueprints.boardly",
    "productName": "Boardly",
    "npmRebuild": false,
    "files": [
      "electron/**",
      "server/**",
      "mcp/**",
      "dist/**",
      "vendor/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "vendor/**"
    ]
  }
}
