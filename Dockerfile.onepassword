FROM boardly-cloud:settings-d2c4e3e
USER root
RUN npm install --prefix /tmp/onepassword --ignore-scripts --no-audit --no-fund @1password/sdk@0.5.0 && cp -a /tmp/onepassword/node_modules/@1password /app/node_modules/ && rm -rf /tmp/onepassword
COPY --chown=node:node package.json package-lock.json /app/
COPY --chown=node:node server/cloud.js server/computeruse-connections.js server/hosted-ai.js server/onepassword.js /app/server/
COPY --chown=node:node dist /app/dist
USER node
RUN node -e "if(typeof require('@1password/sdk').createClient!=='function')process.exit(1)"
