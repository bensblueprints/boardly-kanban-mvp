# Later: comma-separated Clerk Billing personal plan slugs. No prices assumed.
BOARDLY_PAID_PLAN_SLUGS=

# Personal card-funded AI and subscriptions (private configuration; see docs/BILLING.md)
STRIPE_SECRET_KEY=
