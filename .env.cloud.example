# Copy to .env.cloud (gitignored), mode 0600. Do not use the example values.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk's user_... ID for Ben. Email addresses never grant access by themselves.
BOARDLY_OWNER_USER_ID=
BOARDLY_ORIGIN=
