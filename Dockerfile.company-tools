FROM boardly-cloud:live-computer-28425ef
USER root
COPY package.json package-lock.json /app/
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm rebuild better-sqlite3 && chown -R node:node /app/node_modules
COPY --chown=node:node server /app/server
