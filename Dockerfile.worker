FROM boardly-cloud:swarms-ssh-freshness-20260907
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git openssh-client ripgrep python3 python3-venv curl ca-certificates chromium && rm -rf /var/lib/apt/lists/*
RUN npm install -g @openai/codex@0.153.4
COPY server ./server
COPY scripts ./scripts
COPY --chown=node:node deploy/cloud-worker-config.toml /home/node/.codex-defaults/config.toml
COPY --chown=node:node deploy/cloud-worker-AGENTS.md /home/node/.codex-defaults/AGENTS.md
COPY --chown=node:node deploy/worker-entrypoint.cjs /app/worker-entrypoint.cjs
USER node
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
ENTRYPOINT ["node","/app/worker-entrypoint.cjs"]
CMD []
