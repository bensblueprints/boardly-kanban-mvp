FROM node:22-bookworm-slim
RUN npm install -g @openai/codex@0.153.4 && npm cache clean --force
WORKDIR /app
COPY scripts/chatgpt-service.cjs ./
RUN mkdir /profiles && chown node:node /profiles
USER node
ENV PORT=5320
ENV CHATGPT_DATA_DIR=/profiles
VOLUME /profiles
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:5320/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "chatgpt-service.cjs"]
